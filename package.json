{
  "name": "dsh-niao-quick-open",
  "version": "0.4.1",
  "description": "Workspace quick actions in the row menu (⋯): open in file manager / default editor, pick a default editor (auto-discovered). · DeepSeek Harness 工作区行菜单（⋯）快捷操作：文件管理器打开、常用编辑器打开、自动发现并设置常用编辑器。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "editor",
    "quick-open",
    "finder",
    "ui-enhancement"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "check": "node --check lib/index.js && node --check scripts/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
